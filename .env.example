# Database
# --------
# By default this project runs on SQLite with zero external setup.
# The committed prisma/schema.prisma datasource is already set to "sqlite".
#
# DATABASE_URL for SQLite (default, works out of the box):
DATABASE_URL="file:./dev.db"

# To use Postgres instead (Neon, Supabase, Railway, or self-hosted — any
# standard postgres:// connection string works, this app makes no
# provider-specific assumptions):
# 1. Change `provider = "sqlite"` to `provider = "postgresql"` in the
#    `datasource db` block of prisma/schema.prisma.
# 2. Set DATABASE_URL below to your connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"
# 3. First-time setup against a fresh (empty) Postgres database:
#      npx prisma migrate dev --name init
#      npm run db:seed
#    (Do NOT run this against the existing SQLite dev.db — migration
#    history is provider-specific and can't be carried over between them.)
# 4. For production/CI deploys after that, use:
#      npx prisma migrate deploy

# App
NODE_ENV="development"
# Base URL used to build links in emails (verification, password reset,
# team invites). Set to your real deployed URL in production.
APP_URL="http://localhost:3000"

# Auth
# ----
# HMAC secret used to sign/verify session JWTs (src/lib/auth.ts, src/middleware.ts).
# A fixed local-dev fallback is used if this is unset, so `npm run dev` works
# out of the box — but any real deployment MUST set a strong random secret here
# (src/lib/env.ts throws on boot in production if this is missing).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-in-production"

# Email (Resend)
# --------------
# Optional. When unset, src/lib/email.ts no-ops and logs to the console
# instead of sending — signup/password-reset/team-invite flows still work
# end to end without this configured, just without real email delivery.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Nexaris <onboarding@yourdomain.com>"

# AI (Anthropic / Claude)
# ------------------------
# Optional. When unset, src/lib/ai/respond.ts falls back to a deterministic
# placeholder reply — the Simulate Incoming Message / approval queue flow
# still works end to end, just without a real generated response.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Outreach account credentials encryption
# --------------------------------------
# Required only for the Outreach product's Account Health page (saving a
# proxy password). 32-byte key, base64-encoded, for AES-256-GCM
# (src/lib/outreach/crypto.ts). Generate with: openssl rand -base64 32
# OUTREACH_ENCRYPTION_KEY=

# Email Outreach sending (Amazon SES)
# ------------------------------------
# Required only for the Outreach product's Email Outreach channel. When
# unset, src/lib/outreach/ses.ts no-ops and logs to the console instead of
# sending -- approving an email message still works end to end, just
# without a real send. Region defaults to us-east-1 if unset.
# AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_REGION="us-east-1"

# Rate limiting (Upstash Redis)
# ------------------------------
# Optional. When unset, src/lib/rate-limit.ts falls back to an in-memory
# limiter that only works correctly on a single server instance (each
# instance would track its own separate counters). Set both of these once
# you're running more than one server instance so limits are enforced
# consistently across all of them.
# Free tier: https://console.upstash.com -> create a Redis database ->
# copy the REST URL and token shown on the database's detail page.
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
