# Database
# --------
# By default this project runs on SQLite with zero external setup.
# The committed prisma/schema.prisma datasource is already set to "sqlite".
#
# DATABASE_URL for SQLite (default, works out of the box):
DATABASE_URL="file:./dev.db"

# To use Postgres instead (Neon, Supabase, Railway, or self-hosted — any
# standard postgres:// connection string works, this app makes no
# provider-specific assumptions):
# 1. Change `provider = "sqlite"` to `provider = "postgresql"` in the
#    `datasource db` block of prisma/schema.prisma.
# 2. Set DATABASE_URL below to your connection string, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"
# 3. First-time setup against a fresh (empty) Postgres database:
#      npx prisma migrate dev --name init
#      npm run db:seed
#    (Do NOT run this against the existing SQLite dev.db — migration
#    history is provider-specific and can't be carried over between them.)
# 4. For production/CI deploys after that, use:
#      npx prisma migrate deploy

# App
NODE_ENV="development"
# Base URL used to build links in emails (verification, password reset,
# team invites). Set to your real deployed URL in production.
APP_URL="http://localhost:3000"

# Auth
# ----
# HMAC secret used to sign/verify session JWTs (src/lib/auth.ts, src/middleware.ts).
# A fixed local-dev fallback is used if this is unset, so `npm run dev` works
# out of the box — but any real deployment MUST set a strong random secret here
# (src/lib/env.ts throws on boot in production if this is missing).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-in-production"

# Outreach: Connect account (live remote LinkedIn/Instagram login)
# ------------------------------------------------------------------
# Hostname of the droplet's live_login websocket service (see
# outreach/agent/live_login/ and outreach/agent/DEPLOY.md), fronted by a
# reverse proxy terminating TLS. The tenant's browser opens
# wss://<this host>/connect/{accountId} directly -- this app only mints the
# short-lived token, it never proxies the websocket traffic itself.
LIVE_LOGIN_WS_HOST="agent.yourdomain.com"

# Email (Resend)
# --------------
# Used for two distinct things: this app's own transactional email
# (src/lib/email.ts -- signup/password-reset/team-invite, sent from
# EMAIL_FROM) AND Outreach's bulk cold-email channel
# (src/lib/outreach/resend-email.ts -- sent from each client account's own
# configured sesFromEmail/sesFromName, field names kept from the earlier
# SES-based implementation). Replaced AWS SES for Outreach after SES's
# production-access request was rejected with no specific reason given --
# Resend has no equivalent sandbox/approval gate. The domain(s) you send
# FROM (both EMAIL_FROM's domain and every client account's sesFromEmail
# domain) must be verified in Resend's dashboard before it will accept
# sending from that address -- unlike SES, there's no unverified fallback.
# Optional. When unset, both call sites no-op and log to the console
# instead of sending — everything still works end to end without this
# configured, just without real email delivery.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="Nexaris <onboarding@yourdomain.com>"

# AI (Anthropic / Claude)
# ------------------------
# Optional. When unset, src/lib/ai/respond.ts falls back to a deterministic
# placeholder reply — the Simulate Incoming Message / approval queue flow
# still works end to end, just without a real generated response.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Outreach account credentials encryption
# --------------------------------------
# Required only for the Outreach product's Account Health page (saving a
# proxy password). 32-byte key, base64-encoded, for AES-256-GCM
# (src/lib/outreach/crypto.ts). Generate with: openssl rand -base64 32
# OUTREACH_ENCRYPTION_KEY=

# Email Outreach sending (Amazon SES)
# ------------------------------------
# Required only for the Outreach product's Email Outreach channel. When
# unset, src/lib/outreach/ses.ts no-ops and logs to the console instead of
# sending -- approving an email message still works end to end, just
# without a real send. Region defaults to us-east-1 if unset.
#
# Setup checklist (all done in the AWS Console, not this repo):
#   1. Create an AWS account, open SES in your chosen region.
#   2. Verify a sending domain (SES > Verified identities > Create identity)
#      -- add the TXT/CNAME/MX records it gives you to your domain's DNS.
#   3. Request production access (SES starts in "sandbox" mode: it can only
#      send to other verified addresses) -- SES > Account dashboard >
#      Request production access. Usually approved within a day.
#   4. Create an IAM user with an `ses:SendEmail`/`ses:SendRawEmail` policy
#      (not full AWS admin), generate an access key for it -- that key goes
#      below, not your root account's.
#   5. (Optional, needed for bounce tracking) SES > Configuration sets >
#      Create set, add an SNS destination for Bounce/Complaint events,
#      subscribe that SNS topic to this app's
#      https://<domain>/api/webhooks/ses-bounce -- then set
#      AWS_SES_CONFIGURATION_SET below to that set's name.
# AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_REGION="us-east-1"
# AWS_SES_CONFIGURATION_SET=

# Pacing-queue redispatch cron (src/app/api/cron/dispatch-pacing/route.ts)
# ---------------------------------------------------------------------------
# Protects the daily job that resends emails held back by an account's daily
# cap once a new day's quota opens. Generate with: openssl rand -base64 32
# Point any external scheduler (OS cron + curl, hosting platform's scheduled
# functions, etc.) at POST /api/cron/dispatch-pacing with
# `Authorization: Bearer <this value>`, once daily after UTC midnight.
# CRON_SECRET=

# App-wide secret encryption (Agency Gmail/Outlook OAuth tokens)
# ----------------------------------------------------------------
# Required for the Agency product's Gmail/Outlook "Connect" integration
# (src/lib/crypto.ts). Separate key from OUTREACH_ENCRYPTION_KEY above --
# do not reuse that key here or vice versa. 32-byte key, base64-encoded,
# for AES-256-GCM. Generate with: openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# Agency Gmail/Outlook OAuth ("Connect Gmail/Outlook" on the Integrations page)
# --------------------------------------------------------------------------------
# Both optional independently -- Integrations page shows a clear
# "not configured" error for whichever provider's env vars are unset,
# rather than a broken redirect.
#
# Google (Gmail): console.cloud.google.com -> create/select a project ->
# "APIs & Services" -> OAuth consent screen (External, add your own test
# users while unverified) -> Credentials -> Create Credentials -> OAuth
# client ID -> Web application -> Authorized redirect URI:
#   ${APP_URL}/api/oauth/GMAIL/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# Microsoft (Outlook): portal.azure.com -> Microsoft Entra ID -> App
# registrations -> New registration -> Redirect URI (Web):
#   ${APP_URL}/api/oauth/OUTLOOK/callback
# Then Certificates & secrets -> New client secret.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# AWS_REGION="us-east-1"

# Rate limiting (Upstash Redis)
# ------------------------------
# Optional. When unset, src/lib/rate-limit.ts falls back to an in-memory
# limiter that only works correctly on a single server instance (each
# instance would track its own separate counters). Set both of these once
# you're running more than one server instance so limits are enforced
# consistently across all of them.
# Free tier: https://console.upstash.com -> create a Redis database ->
# copy the REST URL and token shown on the database's detail page.
# UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
