# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
prisma/*.db
prisma/*.db-journal

# user-uploaded files (local disk storage, not committed)
/public/uploads/

# generated on every build by scripts/build-extension-zip.mjs (npm run
# build's "prebuild" step) from chrome-extension/ -- a build artifact, not
# source, same reasoning as /public/uploads/ above.
/public/downloads/

# vercel
.vercel

# outreach/ folded into this repo 2026-09-21 per owner's explicit decision
# to consolidate everything into SaaS-Multi -- its own history was preserved
# via `git subtree`, merged in from the AiOutreachAgent repo. That repo still
# exists on GitHub as a historical record but is no longer where new
# outreach/ work is pushed; see outreach/.gitignore for its own secrets/junk
# exclusions (agent/.env, dashboard/.env, debug_captures/, etc.), which
# still apply the normal way now that this is a real subdirectory.

# real client login credentials (plaintext) -- never committed
/credentials/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
