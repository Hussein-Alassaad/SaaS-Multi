// Admin Platform — Prisma schema
// Provider defaults to SQLite for zero-config local dev.
// To use Postgres: see the "Database" section in .env.example for the full
// switch-over steps (change `provider` below to "postgresql", set
// DATABASE_URL, run `prisma migrate dev --name init` against a fresh DB).
// This also unlocks native Prisma enums — SQLite has no enum support, so
// enum-like fields below are modeled as validated `String` columns; see
// src/types for the corresponding TypeScript union types & zod schemas.
// The Postgres migration is deliberately minimal-diff: these String
// "enum" columns and the JSON-encoded String columns (Product.config,
// Plan.features, Invoice.lineItems, AuditLog.oldValue/newValue) are NOT
// converted to native Json/enum types in that pass — zod already
// validates them at the app layer, so that's a deferred nice-to-have,
// not a correctness gap.
//
// String "enum" fields and their allowed values:
//   Product.status            ACTIVE | INACTIVE | MAINTENANCE | FUTURE
//   Tenant.status              ACTIVE | TRIAL | PAST_DUE | SUSPENDED | CHURNED
//   User.scope                 PLATFORM | TENANT
//   User.status                ACTIVE | INVITED | SUSPENDED | DISABLED
//   User.uiLanguage            EN | AR
//   Subscription.status        TRIALING | ACTIVE | PAST_DUE | GRACE_PERIOD | CANCELED | EXPIRED
//   Invoice.status              DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
//   Payment.status               SUCCEEDED | FAILED | PENDING | REFUNDED
//   Payment.method                card | bank_transfer | paypal | omt_wish
//   Refund.status                 PENDING | APPROVED | REJECTED | COMPLETED
//   SupportTicket.priority         LOW | MEDIUM | HIGH | URGENT
//   SupportTicket.status            OPEN | IN_PROGRESS | WAITING_ON_CUSTOMER | RESOLVED | CLOSED
//   SupportTicket.type               BUG | FEATURE_REQUEST | FEEDBACK | QUESTION | BILLING
//   FeatureFlag.scope / AiBudget.scope   GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
//   Notification.audience                 ALL_TENANTS | PRODUCT_TENANTS | SPECIFIC_TENANT | ALL_PLATFORM_USERS
//   Notification.status                    DRAFT | SCHEDULED | SENT | CANCELED
//   Integration.provider                    OPENAI | CLAUDE | GEMINI | SMTP | SUPABASE | CLOUDFLARE | STORAGE | META | WHATSAPP | RESEND | WEBHOOK
//   ClientTask.status                TODO | IN_PROGRESS | DONE
//   ClientMeeting.status              SCHEDULED | COMPLETED | CANCELED
//   TeamInvite.status                 PENDING | ACCEPTED | REVOKED
//
// Nexaris tenant platform (AI Sales & Support) — string "enum" fields:
//   Channel.provider                 WHATSAPP | INSTAGRAM | FACEBOOK
//   Channel.status                   CONNECTED | DISCONNECTED | ERROR
//   Conversation.status              OPEN | PENDING_APPROVAL | AWAITING_CUSTOMER | CLOSED
//   Conversation.stage               NEW | CONTACTED | INTERESTED | MEETING_PENDING | MEETING_BOOKED | WON | LOST
//   Conversation.language            AR | EN
//   Message.sender                   CUSTOMER | AI | HUMAN
//   Message.status                   SENT | PENDING_APPROVAL | APPROVED | REJECTED
//   NexarisClient.tag                 REPLIED | INTERESTED | NOT_RESPONDING | LOST | CONVERTED
//   MeetingSlot.status                 AVAILABLE | BOOKED | BLOCKED
//   MeetingRequest.status               PENDING_APPROVAL | APPROVED | REJECTED | COMPLETED | CANCELED
//   KnowledgeEntry.category             SERVICES | PRICING | FAQ | POLICY | OTHER
//   TenantFeatureRequest.status          NEW | UNDER_REVIEW | PLANNED | COMPLETED | REJECTED
//   AiSettings.tone                     PROFESSIONAL | FRIENDLY | FORMAL
//   AiSettings.primaryLanguage          AR | EN

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core registry
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  status          String   @default("ACTIVE")
  version         String   @default("0.1.0")
  maintenanceMode Boolean  @default(false)
  config          String   @default("{}") // JSON-encoded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants     Tenant[]
  aiUsageLogs AiUsageLog[]

  @@map("products")
}

model Tenant {
  id            String   @id @default(cuid())
  productId     String
  companyName   String
  subdomain     String   @unique
  status        String   @default("TRIAL")
  ownerId       String?
  storageUsedMb Int      @default(0)
  aiCreditsUsed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  owner   User?   @relation("TenantOwner", fields: [ownerId], references: [id])

  users                 User[]                 @relation("TenantUsers")
  subscriptions         Subscription[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  aiUsageLogs           AiUsageLog[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  errorLogs             ErrorLog[]
  impersonationSessions ImpersonationSession[]
  teamInvites           TeamInvite[]

  // Nexaris tenant platform
  channels         Channel[]
  conversations    Conversation[]
  nexarisClients   NexarisClient[]
  meetingSlots     MeetingSlot[]
  meetingRequests  MeetingRequest[]
  knowledgeEntries KnowledgeEntry[]
  featureRequests  TenantFeatureRequest[]
  aiSettings       AiSettings?

  @@index([productId])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Users, roles & permissions
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  avatarUrl             String?
  scope                 String    @default("TENANT")
  status                String    @default("ACTIVE")
  uiLanguage            String    @default("EN") // EN | AR -- dashboard UI language, independent of AiSettings.primaryLanguage (which is customer-facing)
  roleId                String?
  tenantId              String?
  passwordHash          String?
  lastLoginAt           DateTime?
  verifiedAt            DateTime?
  verificationToken     String?   @unique
  verificationExpiresAt DateTime?
  resetToken            String?   @unique
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  role   Role?   @relation(fields: [roleId], references: [id])
  tenant Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])

  ownedTenants          Tenant[]               @relation("TenantOwner")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  auditLogs             AuditLog[]
  aiUsageLogs           AiUsageLog[]
  impersonationsAsAdmin ImpersonationSession[] @relation("ImpersonationAdmin")
  sentTeamInvites       TeamInvite[]
  reviewedPayments      Payment[]              @relation("PaymentReviewedBy")

  // Nexaris tenant platform
  approvalsDecided      Message[]              @relation("MessageApprovedBy")
  meetingsDecided       MeetingRequest[]       @relation("MeetingDecidedBy")
  knowledgeEntriesAdded KnowledgeEntry[]       @relation("KnowledgeEntryAuthor")
  featureRequestsFiled  TenantFeatureRequest[] @relation("FeatureRequestAuthor")

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Owner, Developer, Support, Finance, Sales, Marketing
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  permissions Permission[]
  teamInvites TeamInvite[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  roleId   String
  resource String // e.g. "tenants", "billing", "ai", "settings"
  action   String // e.g. "view", "create", "edit", "delete", "manage"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id             String   @id @default(cuid())
  name           String // Basic / Pro / Enterprise
  slug           String   @unique
  maxUsers       Int
  storageLimitMb Int
  aiCredits      Int
  monthlyPrice   Int // cents
  yearlyPrice    Int // cents
  features       String   @default("[]") // JSON-encoded string[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  planId             String
  status             String    @default("TRIALING")
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  billingCycle       String    @default("monthly") // monthly | yearly
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  number      String    @unique
  status      String    @default("OPEN")
  amountCents Int
  currency    String    @default("usd")
  dueDate     DateTime
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
  lineItems   String    @default("[]") // JSON-encoded

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@map("invoices")
}

model Payment {
  id             String    @id @default(cuid())
  tenantId       String
  invoiceId      String?
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("SUCCEEDED") // SUCCEEDED | FAILED | PENDING | REFUNDED
  method         String    @default("card") // card | bank_transfer | paypal | omt_wish
  proofReference String? // OMT/Wish transaction reference submitted by tenant
  proofNote      String? // optional free-text note from tenant (e.g. sender name/phone)
  reviewedById   String? // platform user who approved/rejected an omt_wish submission
  reviewedAt     DateTime?
  processedAt    DateTime  @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  reviewedBy User?    @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])
  refunds    Refund[]

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String    @id @default(cuid())
  tenantId    String
  paymentId   String
  amountCents Int
  reason      String?
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// AI control center
// ---------------------------------------------------------------------------

model AiUsageLog {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  userId         String?
  model          String
  tokens         Int
  costCents      Int
  responseTimeMs Int
  success        Boolean  @default(true)
  errorMessage   String?
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model AiBudget {
  id                 String   @id @default(cuid())
  scope              String // GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
  scopeId            String? // null when scope = GLOBAL
  dailyBudgetCents   Int
  monthlyBudgetCents Int
  rateLimitPerMin    Int      @default(60)
  defaultModel       String   @default("gpt-4o-mini")
  cachingEnabled     Boolean  @default(true)
  killSwitchEnabled  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Note: scopeId is a polymorphic reference (Product.id, Tenant.id, or
  // Subscription.id depending on `scope`) and intentionally has no FK
  // relation here — resolve it manually via src/lib code per scope.

  @@map("ai_budgets")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id          String    @id @default(cuid())
  tenantId    String
  subject     String
  description String?
  type        String    @default("QUESTION")
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Audit & compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  resource  String?
  tenantId  String?
  ip        String?
  device    String?
  browser   String?
  oldValue  String? // JSON-encoded
  newValue  String? // JSON-encoded
  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Captures failures in operations that would otherwise fail silently (only
// visible in server logs) -- AI reply generation, email sending, etc.
// Distinct from AuditLog, which records successful actor-initiated actions;
// this records unexpected failures regardless of whether a user was involved.
model ErrorLog {
  id        String   @id @default(cuid())
  tenantId  String?
  source    String // e.g. "ai.generate_reply", "email.send", "payment.review"
  message   String
  stack     String?
  context   String? // JSON-encoded, e.g. {conversationId, provider}
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([source])
  @@index([createdAt])
  @@map("error_logs")
}

model ImpersonationSession {
  id        String    @id @default(cuid())
  adminId   String
  tenantId  String
  reason    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  admin  User   @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("impersonation_sessions")
}

// ---------------------------------------------------------------------------
// Feature flags
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String
  name        String
  description String?
  scope       String // GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
  scopeId     String? // null when scope = GLOBAL; productId / tenantId / planId otherwise
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Note: scopeId is a polymorphic reference (Product.id, Tenant.id, or
  // Plan.id depending on `scope`) and intentionally has no FK relation
  // here — resolve it manually via src/lib code per scope.

  @@unique([key, scope, scopeId])
  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Notifications / broadcasts
// ---------------------------------------------------------------------------

model Notification {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String    @default("ALL_TENANTS")
  audienceRef String? // productId or tenantId depending on audience
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Team (member list reuses the existing User/Role models; TeamInvite tracks
// pending invitations only -- no email delivery, invite status is simulated).
// ---------------------------------------------------------------------------

model TeamInvite {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  roleId      String
  status      String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedById String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id])
  invitedBy User?  @relation(fields: [invitedById], references: [id])

  @@index([tenantId])
  @@map("team_invites")
}

// ---------------------------------------------------------------------------
// Nexaris -- AI Sales & Support platform (tenant side)
//
// Core loop: a customer messages the tenant on WhatsApp/Instagram/Facebook ->
// Channel routes it into a Conversation -> AI drafts a Message (Arabic-first)
// -> sensitive/pricing/commitment replies queue for human Approval -> once
// sent, the Conversation's `stage` tracks pipeline progress -> if the
// customer wants a meeting, AI offers open MeetingSlots -> the resulting
// MeetingRequest also needs approval before being confirmed.
//
// NexarisClient is the only "client" concept in this platform -- profiles
// are auto-created on first inbound message and enriched by the AI as it
// collects details during conversation; staff can add free-text notes and
// tags on top.
// ---------------------------------------------------------------------------

model Channel {
  id          String    @id @default(cuid())
  tenantId    String
  provider    String // WHATSAPP | INSTAGRAM | FACEBOOK
  status      String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  displayName String? // e.g. connected page/number name, shown in Integrations UI
  config      String    @default("{}") // JSON-encoded, e.g. { phoneNumberId } -- never store raw secrets here in prod
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("channels")
}

model NexarisClient {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  phone     String?
  email     String?
  company   String?
  needs     String? // free text, filled in as AI collects info during conversation
  tag       String   @default("REPLIED") // REPLIED | INTERESTED | NOT_RESPONDING | LOST | CONVERTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  meetingRequests MeetingRequest[]

  @@index([tenantId])
  @@index([tenantId, updatedAt]) // Clients list: filter by tenant, sort by recency
  @@index([tenantId, phone]) // simulate-inbound-message lookup: find existing client by phone within tenant
  @@map("nexaris_clients")
}

model Conversation {
  id              String   @id @default(cuid())
  tenantId        String
  channelId       String
  nexarisClientId String
  status          String   @default("OPEN") // OPEN | PENDING_APPROVAL | AWAITING_CUSTOMER | CLOSED
  stage           String   @default("NEW") // NEW | CONTACTED | INTERESTED | MEETING_PENDING | MEETING_BOOKED | WON | LOST
  language        String   @default("AR") // AR | EN
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       Channel       @relation(fields: [channelId], references: [id])
  nexarisClient NexarisClient @relation(fields: [nexarisClientId], references: [id], onDelete: Cascade)

  messages        Message[]
  meetingRequests MeetingRequest[]

  @@index([tenantId])
  @@index([channelId])
  @@index([nexarisClientId])
  @@index([stage])
  @@index([tenantId, lastMessageAt]) // Live Inbox / Pipeline list: filter by tenant, sort by recency
  @@index([tenantId, stage, lastMessageAt]) // Pipeline board: filter by tenant+stage, sort by recency
  @@index([nexarisClientId, createdAt]) // Client History: filter by client, sort chronologically
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  sender         String // CUSTOMER | AI | HUMAN
  body           String
  language       String    @default("AR") // AR | EN
  status         String    @default("SENT") // SENT | PENDING_APPROVAL | APPROVED | REJECTED
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("MessageApprovedBy", fields: [approvedById], references: [id])

  @@index([conversationId])
  @@index([status])
  @@index([conversationId, createdAt]) // message thread: filter by conversation, sort chronologically
  @@map("messages")
}

model MeetingSlot {
  id        String   @id @default(cuid())
  tenantId  String
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("AVAILABLE") // AVAILABLE | BOOKED | BLOCKED
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request MeetingRequest?

  @@index([tenantId])
  @@index([status])
  @@map("meeting_slots")
}

model MeetingRequest {
  id              String    @id @default(cuid())
  tenantId        String
  conversationId  String
  nexarisClientId String
  slotId          String    @unique
  status          String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | COMPLETED | CANCELED
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  nexarisClient NexarisClient @relation(fields: [nexarisClientId], references: [id], onDelete: Cascade)
  slot          MeetingSlot   @relation(fields: [slotId], references: [id])
  decidedBy     User?         @relation("MeetingDecidedBy", fields: [decidedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("meeting_requests")
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  category  String   @default("OTHER") // SERVICES | PRICING | FAQ | POLICY | OTHER
  body      String // free text, Arabic-first; injected into AI system context
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("KnowledgeEntryAuthor", fields: [addedById], references: [id])

  @@index([tenantId])
  @@map("knowledge_entries")
}

model TenantFeatureRequest {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String
  status      String   @default("NEW") // NEW | UNDER_REVIEW | PLANNED | COMPLETED | REJECTED
  filedById   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filedBy User?  @relation("FeatureRequestAuthor", fields: [filedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("tenant_feature_requests")
}

// Per-tenant AI configuration -- language, tone, qualification rules.
// One row per tenant (1:1), created on tenant provisioning.
model AiSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tone               String   @default("PROFESSIONAL") // PROFESSIONAL | FRIENDLY | FORMAL
  primaryLanguage    String   @default("AR") // AR | EN
  allowEnglish       Boolean  @default(true)
  qualificationRules String   @default("") // free text, injected into AI system prompt
  approvalRequired   Boolean  @default(true) // require human approval before sending AI replies
  model              String   @default("claude-sonnet-4-5")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}
