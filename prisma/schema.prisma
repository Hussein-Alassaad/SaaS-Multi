// Admin Platform — Prisma schema
// Provider defaults to SQLite for zero-config local dev.
// To use Postgres: see the "Database" section in .env.example for the full
// switch-over steps (change `provider` below to "postgresql", set
// DATABASE_URL, run `prisma migrate dev --name init` against a fresh DB).
// This also unlocks native Prisma enums — SQLite has no enum support, so
// enum-like fields below are modeled as validated `String` columns; see
// src/types for the corresponding TypeScript union types & zod schemas.
// The Postgres migration is deliberately minimal-diff: these String
// "enum" columns and the JSON-encoded String columns (Product.config,
// Plan.features, Invoice.lineItems, AuditLog.oldValue/newValue) are NOT
// converted to native Json/enum types in that pass — zod already
// validates them at the app layer, so that's a deferred nice-to-have,
// not a correctness gap.
//
// String "enum" fields and their allowed values:
//   Product.status            ACTIVE | INACTIVE | MAINTENANCE | FUTURE
//   Tenant.status              ACTIVE | TRIAL | PAST_DUE | SUSPENDED | CHURNED
//   User.scope                 PLATFORM | TENANT
//   User.status                ACTIVE | INVITED | SUSPENDED | DISABLED
//   User.uiLanguage            EN | AR
//   Subscription.status        TRIALING | ACTIVE | PAST_DUE | GRACE_PERIOD | CANCELED | EXPIRED
//   Invoice.status              DRAFT | OPEN | PAID | VOID | UNCOLLECTIBLE
//   Payment.status               SUCCEEDED | FAILED | PENDING | REFUNDED
//   Payment.method                card | bank_transfer | paypal | omt_wish
//   Refund.status                 PENDING | APPROVED | REJECTED | COMPLETED
//   SupportTicket.priority         LOW | MEDIUM | HIGH | URGENT
//   SupportTicket.status            OPEN | IN_PROGRESS | WAITING_ON_CUSTOMER | RESOLVED | CLOSED
//   SupportTicket.type               BUG | FEATURE_REQUEST | FEEDBACK | QUESTION | BILLING
//   FeatureFlag.scope / AiBudget.scope   GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
//   Notification.audience                 ALL_TENANTS | PRODUCT_TENANTS | SPECIFIC_TENANT | ALL_PLATFORM_USERS
//   Notification.status                    DRAFT | SCHEDULED | SENT | CANCELED
//   Integration.provider                    OPENAI | CLAUDE | GEMINI | SMTP | SUPABASE | CLOUDFLARE | STORAGE | META | WHATSAPP | RESEND | WEBHOOK
//   ClientTask.status                TODO | IN_PROGRESS | DONE
//   ClientMeeting.status              SCHEDULED | COMPLETED | CANCELED
//   TeamInvite.status                 PENDING | ACCEPTED | REVOKED
//
// Nexaris tenant platform (AI Sales & Support) — string "enum" fields:
//   Channel.provider                 WHATSAPP | INSTAGRAM | FACEBOOK | GMAIL | OUTLOOK
//   Channel.status                   CONNECTED | DISCONNECTED | ERROR
//   Conversation.status              OPEN | PENDING_APPROVAL | AWAITING_CUSTOMER | CLOSED
//   Conversation.stage               NEW | CONTACTED | INTERESTED | MEETING_PENDING | MEETING_BOOKED | WON | LOST
//   Conversation.language            AR | EN
//   Message.sender                   CUSTOMER | AI | HUMAN
//   Message.status                   SENT | PENDING_APPROVAL | APPROVED | REJECTED
//   NexarisClient.tag                 REPLIED | INTERESTED | NOT_RESPONDING | LOST | CONVERTED
//   MeetingSlot.status                 AVAILABLE | BOOKED | BLOCKED
//   MeetingRequest.status               PENDING_APPROVAL | APPROVED | REJECTED | COMPLETED | CANCELED
//   KnowledgeEntry.category             SERVICES | PRICING | FAQ | POLICY | OTHER
//   TenantFeatureRequest.status          NEW | UNDER_REVIEW | PLANNED | COMPLETED | REJECTED
//   AiSettings.tone                     PROFESSIONAL | FRIENDLY | FORMAL
//   AiSettings.primaryLanguage          AR | EN

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core registry
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String?
  status          String   @default("ACTIVE")
  version         String   @default("0.1.0")
  maintenanceMode Boolean  @default(false)
  config          String   @default("{}") // JSON-encoded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants     Tenant[]
  aiUsageLogs AiUsageLog[]

  @@map("products")
}

model Tenant {
  id            String   @id @default(cuid())
  productId     String
  companyName   String
  subdomain     String   @unique
  status        String   @default("TRIAL")
  ownerId       String?
  storageUsedMb Int      @default(0)
  aiCreditsUsed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  owner   User?   @relation("TenantOwner", fields: [ownerId], references: [id])

  users                 User[]                 @relation("TenantUsers")
  subscriptions         Subscription[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  aiUsageLogs           AiUsageLog[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  errorLogs             ErrorLog[]
  impersonationSessions ImpersonationSession[]
  teamInvites           TeamInvite[]

  // Nexaris tenant platform
  channels         Channel[]
  conversations    Conversation[]
  nexarisClients   NexarisClient[]
  meetingSlots     MeetingSlot[]
  meetingRequests  MeetingRequest[]
  knowledgeEntries KnowledgeEntry[]
  featureRequests  TenantFeatureRequest[]
  aiSettings       AiSettings?

  // Outreach tenant platform
  outreachAccounts        OutreachAccount[]
  outreachSettings        OutreachSettings?
  outreachLeads           OutreachLead[]
  outreachMessages        OutreachMessage[]
  outreachPipelineHistory OutreachPipelineHistory[]
  outreachFollowUps       OutreachFollowUp[]
  outreachClientHistory   OutreachClientHistory[]
  outreachNotifications   OutreachNotificationLog[]
  outreachRuns            OutreachRun[]
  outreachReplies         OutreachReply[]

  @@index([productId])
  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Users, roles & permissions
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  avatarUrl             String?
  scope                 String    @default("TENANT")
  status                String    @default("ACTIVE")
  uiLanguage            String    @default("EN") // EN | AR -- dashboard UI language, independent of AiSettings.primaryLanguage (which is customer-facing)
  roleId                String?
  tenantId              String?
  passwordHash          String?
  lastLoginAt           DateTime?
  verifiedAt            DateTime?
  verificationToken     String?   @unique
  verificationExpiresAt DateTime?
  resetToken            String?   @unique
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  role   Role?   @relation(fields: [roleId], references: [id])
  tenant Tenant? @relation("TenantUsers", fields: [tenantId], references: [id])

  ownedTenants          Tenant[]               @relation("TenantOwner")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  auditLogs             AuditLog[]
  aiUsageLogs           AiUsageLog[]
  impersonationsAsAdmin ImpersonationSession[] @relation("ImpersonationAdmin")
  sentTeamInvites       TeamInvite[]
  reviewedPayments      Payment[]              @relation("PaymentReviewedBy")

  // Nexaris tenant platform
  approvalsDecided      Message[]              @relation("MessageApprovedBy")
  meetingsDecided       MeetingRequest[]       @relation("MeetingDecidedBy")
  knowledgeEntriesAdded KnowledgeEntry[]       @relation("KnowledgeEntryAuthor")
  featureRequestsFiled  TenantFeatureRequest[] @relation("FeatureRequestAuthor")

  // Outreach tenant platform
  outreachApprovalsDecided OutreachMessage[] @relation("OutreachMessageApprovedBy")

  sessions         UserSession[]
  createdApiKeys   ApiKey[]
  createdAllowlist IpAllowlistEntry[]

  @@index([tenantId])
  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Real session tracking (added 2026-08-22) -- replaces the previously fully
// stateless-JWT login (a valid signature was the ONLY check; there was no
// database record of who was logged in from where, and therefore no way to
// list or revoke one specific browser session). Every login now creates one
// row here, whose id is embedded in the session JWT itself
// (SessionPayload.sessionId, src/lib/auth.ts) -- verifySessionToken() now
// ALSO looks up this row and rejects the token if it's missing or
// revokedAt is set, so revoking a session here takes effect immediately
// project-wide (Admin AND every tenant/client login, platform-wide per the
// explicit requirement this was built to), not just next time the JWT
// happens to expire on its own.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  device       String? // parsed from User-Agent at login time, e.g. "Chrome on macOS"
  ip           String?
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now()) // touched opportunistically on requests, not every single one -- see verifySessionToken()'s throttling comment
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// Platform-level API keys for external integrations (Admin -> Security page).
// The real secret is shown to the admin exactly once, at creation
// (createApiKeyAction's return value) -- only its SHA-256 hash is ever
// persisted, same reasoning as a password hash: this table being read
// (backup, breach, careless query in a debugger) must not itself hand out
// working credentials.
model ApiKey {
  id          String    @id @default(cuid())
  label       String
  keyHash     String // SHA-256 hex of the real key -- never the plaintext key itself
  keyPreview  String // last 4 chars of the real key, shown in the UI so an admin can tell keys apart without re-seeing the secret
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("api_keys")
}

// IP allowlist for restricting Admin platform access -- see
// src/middleware.ts for where this is actually enforced.
model IpAllowlistEntry {
  id          String   @id @default(cuid())
  cidr        String // single IP or CIDR range, e.g. "203.0.113.0/24"
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])

  @@unique([cidr])
  @@map("ip_allowlist_entries")
}

// Platform-wide security policy toggles (MFA/SSO requirements) -- a
// single row, not per-tenant (Admin's Security page is platform-owner-only;
// see agencyGuardResult/guard's "billing"/"security" resource split for
// tenant-level settings, which are separate and already covered by
// AiSettings and similar per-tenant models).
model SecurityPolicy {
  id          String   @id @default("singleton")
  mfaRequired Boolean  @default(false)
  ssoEnforced Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("security_policy")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // Owner, Developer, Support, Finance, Sales, Marketing
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  permissions Permission[]
  teamInvites TeamInvite[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  roleId   String
  resource String // e.g. "tenants", "billing", "ai", "settings"
  action   String // e.g. "view", "create", "edit", "delete", "manage"

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// Plans & subscriptions
// ---------------------------------------------------------------------------

model Plan {
  id             String   @id @default(cuid())
  name           String // Basic / Pro / Enterprise
  slug           String   @unique
  maxUsers       Int
  storageLimitMb Int
  aiCredits      Int
  monthlyPrice   Int // cents
  yearlyPrice    Int // cents
  features       String   @default("[]") // JSON-encoded string[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  planId             String
  status             String    @default("TRIALING")
  trialEndsAt        DateTime?
  gracePeriodEndsAt  DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  billingCycle       String    @default("monthly") // monthly | yearly
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  number      String    @unique
  status      String    @default("OPEN")
  amountCents Int
  currency    String    @default("usd")
  dueDate     DateTime
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
  lineItems   String    @default("[]") // JSON-encoded

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@map("invoices")
}

model Payment {
  id             String    @id @default(cuid())
  tenantId       String
  invoiceId      String?
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("SUCCEEDED") // SUCCEEDED | FAILED | PENDING | REFUNDED
  method         String    @default("card") // card | bank_transfer | paypal | omt_wish
  proofReference String? // OMT/Wish transaction reference submitted by tenant
  proofNote      String? // optional free-text note from tenant (e.g. sender name/phone)
  reviewedById   String? // platform user who approved/rejected an omt_wish submission
  reviewedAt     DateTime?
  processedAt    DateTime  @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  reviewedBy User?    @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])
  refunds    Refund[]

  @@index([tenantId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id          String    @id @default(cuid())
  tenantId    String
  paymentId   String
  amountCents Int
  reason      String?
  status      String    @default("PENDING")
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([tenantId])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// AI control center
// ---------------------------------------------------------------------------

model AiUsageLog {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  userId         String?
  model          String
  tokens         Int
  costCents      Int
  responseTimeMs Int
  success        Boolean  @default(true)
  errorMessage   String?
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model AiBudget {
  id                 String   @id @default(cuid())
  scope              String // GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
  scopeId            String? // null when scope = GLOBAL
  dailyBudgetCents   Int
  monthlyBudgetCents Int
  rateLimitPerMin    Int      @default(60)
  defaultModel       String   @default("gpt-4o-mini")
  cachingEnabled     Boolean  @default(true)
  killSwitchEnabled  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Note: scopeId is a polymorphic reference (Product.id, Tenant.id, or
  // Subscription.id depending on `scope`) and intentionally has no FK
  // relation here — resolve it manually via src/lib code per scope.

  @@map("ai_budgets")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id          String    @id @default(cuid())
  tenantId    String
  subject     String
  description String?
  type        String    @default("QUESTION")
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@map("support_tickets")
}

// ---------------------------------------------------------------------------
// Audit & compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  resource  String?
  tenantId  String?
  ip        String?
  device    String?
  browser   String?
  oldValue  String? // JSON-encoded
  newValue  String? // JSON-encoded
  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Captures failures in operations that would otherwise fail silently (only
// visible in server logs) -- AI reply generation, email sending, etc.
// Distinct from AuditLog, which records successful actor-initiated actions;
// this records unexpected failures regardless of whether a user was involved.
model ErrorLog {
  id         String   @id @default(cuid())
  tenantId   String?
  source     String // e.g. "ai.generate_reply", "email.send", "payment.review", "outreach.discovery"
  message    String
  stack      String?
  context    String? // JSON-encoded, e.g. {conversationId, provider}
  resolved   Boolean  @default(false)
  isExpected Boolean  @default(false) // true for routine/expected skips (e.g. Outreach's "not a real business" qualification miss) vs. real failures -- lets a source's UI offer a Real problems / Normal skips / All filter
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([source])
  @@index([createdAt])
  @@map("error_logs")
}

model ImpersonationSession {
  id        String    @id @default(cuid())
  adminId   String
  tenantId  String
  reason    String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  admin  User   @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("impersonation_sessions")
}

// ---------------------------------------------------------------------------
// Feature flags
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String
  name        String
  description String?
  scope       String // GLOBAL | PRODUCT | TENANT | SUBSCRIPTION
  scopeId     String? // null when scope = GLOBAL; productId / tenantId / planId otherwise
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Note: scopeId is a polymorphic reference (Product.id, Tenant.id, or
  // Plan.id depending on `scope`) and intentionally has no FK relation
  // here — resolve it manually via src/lib code per scope.

  @@unique([key, scope, scopeId])
  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Notifications / broadcasts
// ---------------------------------------------------------------------------

model Notification {
  id          String    @id @default(cuid())
  title       String
  body        String
  imageUrl    String? // optional attached image, served from public/uploads (see src/lib/storage.ts)
  audience    String    @default("ALL_TENANTS")
  audienceRef String? // productId or tenantId depending on audience
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Team (member list reuses the existing User/Role models; TeamInvite tracks
// pending invitations only -- no email delivery, invite status is simulated).
// ---------------------------------------------------------------------------

model TeamInvite {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  roleId      String
  status      String    @default("PENDING") // PENDING | ACCEPTED | REVOKED
  invitedById String?
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id])
  invitedBy User?  @relation(fields: [invitedById], references: [id])

  @@index([tenantId])
  @@map("team_invites")
}

// ---------------------------------------------------------------------------
// Nexaris -- AI Sales & Support platform (tenant side)
//
// Core loop: a customer messages the tenant on WhatsApp/Instagram/Facebook ->
// Channel routes it into a Conversation -> AI drafts a Message (Arabic-first)
// -> sensitive/pricing/commitment replies queue for human Approval -> once
// sent, the Conversation's `stage` tracks pipeline progress -> if the
// customer wants a meeting, AI offers open MeetingSlots -> the resulting
// MeetingRequest also needs approval before being confirmed.
//
// NexarisClient is the only "client" concept in this platform -- profiles
// are auto-created on first inbound message and enriched by the AI as it
// collects details during conversation; staff can add free-text notes and
// tags on top.
// ---------------------------------------------------------------------------

model Channel {
  id          String    @id @default(cuid())
  tenantId    String
  provider    String // WHATSAPP | INSTAGRAM | FACEBOOK | GMAIL | OUTLOOK
  status      String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  displayName String? // e.g. connected page/number name, shown in Integrations UI
  config      String    @default("{}") // JSON-encoded, e.g. { phoneNumberId } -- never store raw secrets here in prod
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // GMAIL/OUTLOOK OAuth (added 2026-08-22) -- real "Connect Gmail/Outlook"
  // flow, distinct from WHATSAPP/INSTAGRAM/FACEBOOK's still-simulated
  // connection (see agency-integrations.ts's toggleChannelConnectionAction
  // comment). The tenant authorizes via Google/Microsoft's own OAuth
  // consent page; this app never sees or stores their password, only the
  // resulting tokens -- which ARE real secrets and, unlike the loose
  // `config` JSON above, are encrypted at rest (src/lib/crypto.ts, same
  // AES-256-GCM scheme Outreach uses for proxy passwords, but under
  // APP_ENCRYPTION_KEY, a separate key). Null/empty for every other
  // provider.
  oauthEmail        String? // the connected mailbox address, e.g. "owner@gmail.com" -- shown in the UI, not secret
  oauthAccessToken  String? // encrypted (encryptSecret()) -- short-lived, refreshed via oauthRefreshToken
  oauthRefreshToken String? // encrypted (encryptSecret()) -- long-lived, what actually lets this app keep sending/reading without the tenant re-authorizing
  oauthExpiresAt    DateTime? // when oauthAccessToken expires -- callers refresh proactively past this, not on a 401

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("channels")
}

model NexarisClient {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  phone     String?
  email     String?
  company   String?
  needs     String? // free text, filled in as AI collects info during conversation
  tag       String   @default("REPLIED") // REPLIED | INTERESTED | NOT_RESPONDING | LOST | CONVERTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   Conversation[]
  meetingRequests MeetingRequest[]

  @@index([tenantId])
  @@index([tenantId, updatedAt]) // Clients list: filter by tenant, sort by recency
  @@index([tenantId, phone]) // simulate-inbound-message lookup: find existing client by phone within tenant
  @@map("nexaris_clients")
}

model Conversation {
  id              String   @id @default(cuid())
  tenantId        String
  channelId       String
  nexarisClientId String
  status          String   @default("OPEN") // OPEN | PENDING_APPROVAL | AWAITING_CUSTOMER | CLOSED
  stage           String   @default("NEW") // NEW | CONTACTED | INTERESTED | MEETING_PENDING | MEETING_BOOKED | WON | LOST
  language        String   @default("AR") // AR | EN
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       Channel       @relation(fields: [channelId], references: [id])
  nexarisClient NexarisClient @relation(fields: [nexarisClientId], references: [id], onDelete: Cascade)

  messages        Message[]
  meetingRequests MeetingRequest[]

  @@index([tenantId])
  @@index([channelId])
  @@index([nexarisClientId])
  @@index([stage])
  @@index([tenantId, lastMessageAt]) // Live Inbox / Pipeline list: filter by tenant, sort by recency
  @@index([tenantId, stage, lastMessageAt]) // Pipeline board: filter by tenant+stage, sort by recency
  @@index([nexarisClientId, createdAt]) // Client History: filter by client, sort chronologically
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  sender         String // CUSTOMER | AI | HUMAN
  body           String
  language       String    @default("AR") // AR | EN
  status         String    @default("SENT") // SENT | PENDING_APPROVAL | APPROVED | REJECTED
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("MessageApprovedBy", fields: [approvedById], references: [id])

  @@index([conversationId])
  @@index([status])
  @@index([conversationId, createdAt]) // message thread: filter by conversation, sort chronologically
  @@map("messages")
}

model MeetingSlot {
  id        String   @id @default(cuid())
  tenantId  String
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("AVAILABLE") // AVAILABLE | BOOKED | BLOCKED
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request MeetingRequest?

  @@index([tenantId])
  @@index([status])
  @@map("meeting_slots")
}

model MeetingRequest {
  id              String    @id @default(cuid())
  tenantId        String
  conversationId  String
  nexarisClientId String
  slotId          String    @unique
  status          String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | COMPLETED | CANCELED
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  nexarisClient NexarisClient @relation(fields: [nexarisClientId], references: [id], onDelete: Cascade)
  slot          MeetingSlot   @relation(fields: [slotId], references: [id])
  decidedBy     User?         @relation("MeetingDecidedBy", fields: [decidedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("meeting_requests")
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  category  String   @default("OTHER") // SERVICES | PRICING | FAQ | POLICY | OTHER
  body      String // free text, Arabic-first; injected into AI system context
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addedBy User?  @relation("KnowledgeEntryAuthor", fields: [addedById], references: [id])

  @@index([tenantId])
  @@map("knowledge_entries")
}

model TenantFeatureRequest {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String
  status      String   @default("NEW") // NEW | UNDER_REVIEW | PLANNED | COMPLETED | REJECTED
  filedById   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  filedBy User?  @relation("FeatureRequestAuthor", fields: [filedById], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("tenant_feature_requests")
}

// Per-tenant AI configuration -- language, tone, qualification rules.
// One row per tenant (1:1), created on tenant provisioning.
model AiSettings {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tone               String   @default("PROFESSIONAL") // PROFESSIONAL | FRIENDLY | FORMAL
  primaryLanguage    String   @default("AR") // AR | EN
  allowEnglish       Boolean  @default(true)
  qualificationRules String   @default("") // free text, injected into AI system prompt
  approvalRequired   Boolean  @default(true) // require human approval before sending AI replies
  model              String   @default("claude-sonnet-4-5")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// ---------------------------------------------------------------------------
// Outreach tenant platform (AI lead-discovery & outreach agent)
// Rebuilt multi-tenant from a prior single-tenant version. Every table below
// carries tenantId; the Python agent (outside this Prisma schema) writes to
// the same Postgres tables via the Supabase service-role key, so field names
// are @map()'d to snake_case to match its existing repositories.py column
// expectations without a rewrite of every dict-key reference.
// String "enum" fields:
//   OutreachAccount.status          active | warned | paused
//   OutreachLead.platform            linkedin | instagram
//   OutreachLead.status               discovered | analyzed | awaiting_approval | approved
//                                     | manual_send_pending | contacted | replied | interested
//                                     | meeting_booked | deal_closed | lost
//   OutreachLead.temperature          hot | warm | cold
//   OutreachMessage.channel            linkedin | whatsapp | instagram
//   OutreachMessage.approvalStatus     awaiting | approved | held | edited
//   OutreachMessage.sendStatus         pending | sent | manual_pending | failed | queued_for_pacing
//   OutreachSettings.messageStyle      direct | discovery
//   OutreachFollowUp.status            scheduled | sent | cancelled | paused
//   OutreachRun.status                 running | completed | error
// ---------------------------------------------------------------------------

model OutreachAccount {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  label              String
  platform           String    @default("linkedin") // "instagram" | "linkedin" | "email" -- which channel this account sends through
  platformHandles    String    @default("{}") @map("platform_handles") // JSON-encoded {linkedin, instagram}
  runTime            String    @default("09:00") @map("run_time") // "HH:MM", interpreted in the tenant's configured timezone
  igDailyLimit       Int       @default(20) @map("ig_daily_limit")
  linkedinDailyLimit Int       @default(30) @map("linkedin_daily_limit")
  // Default lowered 2026-08-21: 300/day was this column's original value,
  // but every real client onboarded so far targets ~300 EMAILS PER MONTH
  // (roughly 10/day) -- 300/day was never actually a client's real target,
  // it was this column's placeholder default from before any real client
  // existed. 10/day also happens to land right at the safe week-1 warm-up
  // pace the strategy doc recommends (Downloads/
  // B2B_AI_Outreach_System_Complete_Guide.md, Part 5) rather than needing a
  // separate ramp-up mechanic the way LinkedIn/Instagram's warmupCurrentLimit
  // does -- a client's actual monthly target is naturally a safe daily pace
  // already, so no additional warm-up ramp was built for this field.
  emailDailyLimit    Int       @default(10) @map("email_daily_limit")
  sentCount          Int       @default(0) @map("sent_count") // real SES sends via this account, all-time -- denominator for bounceRate below
  bounceCount        Int       @default(0) @map("bounce_count") // incremented only by a real SES bounce notification (see src/app/api/webhooks/ses-bounce/route.ts), never guessed
  proxyHost          String?   @map("proxy_host")
  proxyPort          String?   @map("proxy_port")
  proxyUsername      String?   @map("proxy_username")
  proxyPasswordEnc   String?   @map("proxy_password_enc") // encrypted at rest (AES-256-GCM, see src/lib/outreach/crypto.ts) -- multiple real tenants' credentials now share this table, unlike the original single-tenant version
  verifiedProxyIp    String?   @map("verified_proxy_ip") // the real outbound IP this account's proxy resolved to on its first successful verified run -- checked on every later run (agent/core/session.py's verify_proxy_ip()) so an account never runs through a DIFFERENT IP than it always has (the exact "HARD RULE" this model's proxyHost/proxyPort/proxyUsername fields document, now actually enforced at runtime, not just assumed)
  // Platform login credentials -- the TENANT enters their own account's real
  // email/password directly in the Account Health dashboard (self-service,
  // no admin/agency-owner in the loop -- see src/lib/outreach/crypto.ts for
  // the same AES-256-GCM-at-rest scheme already used for proxyPasswordEnc).
  // The Python agent performs the actual browser login using these, through
  // this account's proxy above. Only meaningful when platform = "linkedin"
  // or "instagram" -- unused for platform = "email" (that channel sends via
  // SES using sesFromEmail/sesFromName below, no login/browser involved at
  // all). Login is unsupervised by design (tenant's explicit choice) -- see
  // outreach/PROGRESS.md's dated entry on this feature for the accepted
  // tradeoff (a fresh automated login is LinkedIn/Instagram's single
  // highest-risk moment for a security challenge the agent can't solve
  // blind, vs. reusing an already-established session).
  loginEmail         String?   @map("login_email")
  loginPasswordEnc   String?   @map("login_password_enc")
  loginStatus        String    @default("not_connected") @map("login_status") // not_connected | pending_first_login | connecting | connected | failed
  loginError         String?   @map("login_error") // human-readable reason from the last failed login attempt, cleared on the next success
  loginConnectedAt   DateTime? @map("login_connected_at")
  // Set the moment a live "Connect account" websocket session starts (see
  // outreach/agent/live_login/), alongside loginStatus="connecting". Lets the
  // UI detect and recover from a stuck "Connecting..." state if the droplet
  // process crashes mid-session and never gets to write a final status --
  // AccountHealthClient treats "connecting" older than ~15 minutes as
  // effectively failed and offers a retry, rather than showing a
  // permanently-stuck badge with no way out.
  loginConnectingAt  DateTime? @map("login_connecting_at")
  sesFromEmail       String?   @map("ses_from_email") // verified SES sender identity -- only used when platform = "email"
  sesFromName        String?   @map("ses_from_name")
  warmupCurrentLimit Int       @default(5) @map("warmup_current_limit")
  status             String    @default("active")
  warningType        String?   @map("warning_type")
  warningReason      String?   @map("warning_reason")
  redistributeFlag   Boolean   @default(false) @map("redistribute_flag")
  lastActiveAt       DateTime? @map("last_active_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads        OutreachLead[]
  runs         OutreachRun[]
  sentMessages OutreachMessage[] @relation("OutreachSentViaAccount")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, platform])
  @@map("outreach_accounts")
}

// Single row per tenant (was one single global row pre-rebuild).
model OutreachSettings {
  id                      String   @id @default(cuid())
  tenantId                String   @unique @map("tenant_id")
  businessName            String   @default("") @map("business_name")
  businessDescription     String   @default("") @map("business_description")
  targetNiche             String   @default("") @map("target_niche")
  targetIndustry          String   @default("") @map("target_industry")
  targetLocation          String   @default("") @map("target_location")
  targetBusinessType      String   @default("") @map("target_business_type")
  targetCompanySizeMin    Int?     @map("target_company_size_min")
  targetCompanySizeMax    Int?     @map("target_company_size_max")
  targetNeeds             String   @default("[]") @map("target_needs") // JSON-encoded string[] -- e.g. ["security systems","cameras"]
  outreachLanguages       String   @default("[\"English\"]") @map("outreach_languages") // JSON-encoded string[]
  messageStyle            String   @default("discovery") @map("message_style")
  styleDurationDays       Int      @default(7) @map("style_duration_days")
  styleLastRotatedAt      DateTime @default(now()) @map("style_last_rotated_at")
  defaultRecontactGapDays Int      @default(30) @map("default_recontact_gap_days")
  maxContactsPerLead      Int      @default(2) @map("max_contacts_per_lead")
  whatsappRecipient1      String?  @map("whatsapp_recipient_1")
  whatsappRecipient2      String?  @map("whatsapp_recipient_2")
  approvalRequired        Boolean  @default(true) @map("approval_required")
  approvalReminderHours   Int      @default(24) @map("approval_reminder_hours")
  // IANA zone name (e.g. "America/New_York") that every OutreachAccount.runTime
  // for this tenant is interpreted against -- Admin-only editable (see
  // setOutreachTimezoneAction in src/lib/actions/admin-tenants.ts), shown
  // read-only on the tenant's own Settings page. Falls back to the agent's
  // config.TIMEZONE if this row is somehow missing (new-tenant safety net,
  // not expected in normal operation since this column always has a default).
  timezone                String   @default("Asia/Beirut")
  updatedAt               DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("outreach_settings")
}

model OutreachLead {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  accountId           String?   @map("account_id")
  platform            String
  businessName        String?   @map("business_name")
  profileUrl          String?   @map("profile_url")
  profilePhotoUrl     String?   @map("profile_photo_url")
  followerCount       Int?      @map("follower_count")
  industry            String?
  website             String?
  socialPlatforms     String    @default("[]") @map("social_platforms") // JSON
  companySize         String?   @map("company_size")
  revenueTier         String?   @map("revenue_tier")
  adsRunning          Boolean?  @map("ads_running")
  weakPoints          String    @default("[]") @map("weak_points") // JSON
  aiOpportunities     String    @default("[]") @map("ai_opportunities") // JSON
  founderFound        Boolean   @default(false) @map("founder_found")
  founderName         String?   @map("founder_name")
  founderSourcePhrase String?   @map("founder_source_phrase")
  whatsappFound       Boolean   @default(false) @map("whatsapp_found")
  whatsappNumber      String?   @map("whatsapp_number")
  contactEmail        String?   @map("contact_email") // discovered/verified email address -- only populated for platform="email" leads (added for SES-based Email Outreach; the original IG/LinkedIn-only app never captured one)
  score               Int?
  temperature         String?
  scoreReasoning      String?   @map("score_reasoning")
  generatedMessage    String?   @map("generated_message")
  messageStyleUsed    String?   @map("message_style_used")
  status              String    @default("discovered")
  contactCount        Int       @default(0) @map("contact_count")
  firstContactedAt    DateTime? @map("first_contacted_at")
  doNotContact        Boolean   @default(false) @map("do_not_contact") // permanent opt-out -- independent of `status` (a lead's pipeline stage), checked before every send on every channel
  doNotContactReason  String?   @map("do_not_contact_reason")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account OutreachAccount? @relation(fields: [accountId], references: [id])

  messages        OutreachMessage[]
  pipelineHistory OutreachPipelineHistory[]
  followUps       OutreachFollowUp[]
  clientHistory   OutreachClientHistory[]
  notifications   OutreachNotificationLog[]
  replies         OutreachReply[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, score])
  @@index([tenantId, updatedAt])
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, whatsappFound])
  @@index([tenantId, profileUrl])
  @@index([tenantId, platform])
  @@map("outreach_leads")
}

model OutreachMessage {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  leadId           String    @map("lead_id")
  channel          String
  body             String
  isFollowup       Boolean   @default(false) @map("is_followup")
  isReengagement   Boolean   @default(false) @map("is_reengagement")
  // A tenant-written reply sent from the "Reply Here" dashboard page
  // (src/app/(outreach)/outreach/replies/), not agent-generated cold
  // outreach -- tells the Python send-side (sending/*_send.py) to deliver
  // this INTO the lead's existing conversation thread (reply-in-thread)
  // instead of opening a fresh connection request / new email thread.
  // Always created with approvalStatus="approved" already set (the tenant
  // typing it and hitting Send IS the approval -- no separate review step),
  // and picked up by a fast-polling loop (scheduler.py's
  // run_reply_send_cycle(), ~every 2-3 min) rather than the normal daily
  // full-cycle send, so a reply feels close to real-time.
  isReply          Boolean   @default(false) @map("is_reply")
  // Optional media attachment on a reply (Vercel Blob URL -- see
  // src/lib/outreach/reply-attachments.ts). Body can be empty when an
  // attachment carries the whole message (e.g. a voice note with no typed
  // text) -- sendReplyAction() only requires at least one of body/attachment,
  // not both. Never set on agent-generated cold outreach.
  attachmentUrl    String?   @map("attachment_url")
  attachmentKind   String?   @map("attachment_kind") // "image" | "video" | "audio" | "file"
  attachmentName   String?   @map("attachment_name") // original filename, for display
  approvalStatus   String    @default("awaiting") @map("approval_status")
  approvedById     String?   @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  editedBody       String?   @map("edited_body")
  holdReason       String?   @map("hold_reason")
  sendStatus       String    @default("pending") @map("send_status")
  sentAt           DateTime? @map("sent_at")
  sentViaAccountId String?   @map("sent_via_account_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead           OutreachLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentViaAccount OutreachAccount? @relation("OutreachSentViaAccount", fields: [sentViaAccountId], references: [id])
  approvedBy     User?            @relation("OutreachMessageApprovedBy", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@index([tenantId, approvalStatus])
  @@index([tenantId, approvalStatus, sendStatus])
  @@index([tenantId, isReply, sendStatus])
  @@map("outreach_messages")
}

model OutreachPipelineHistory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  leadId    String   @map("lead_id")
  fromStage String?  @map("from_stage")
  toStage   String   @map("to_stage")
  changedBy String   @default("agent") @map("changed_by") // "agent" | User.id | "manual"
  changedAt DateTime @default(now()) @map("changed_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId, changedAt])
  @@map("outreach_pipeline_history")
}

model OutreachFollowUp {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  leadId         String    @map("lead_id")
  enabled        Boolean   @default(false)
  scheduledFor   DateTime? @map("scheduled_for")
  isReengagement Boolean   @default(false) @map("is_reengagement")
  status         String    @default("scheduled")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, enabled, status, scheduledFor])
  @@map("outreach_follow_ups")
}

// Permanent record of every analyzed lead -- never resets, distinct from
// the live outreach_leads feed.
model OutreachClientHistory {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  leadId       String?  @map("lead_id")
  businessName String?  @map("business_name")
  platform     String?
  industry     String?
  score        Int?
  temperature  String?
  weakPoints   String?  @map("weak_points") // JSON
  founderFound Boolean? @map("founder_found")
  founderName  String?  @map("founder_name")
  contacted    Boolean  @default(false)
  snapshot     String? // JSON -- full lead snapshot at analysis time
  analyzedAt   DateTime @default(now()) @map("analyzed_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, analyzedAt])
  @@map("outreach_client_history")
}

model OutreachNotificationLog {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  type          String // hot_lead | founder | warning | approval_reminder | daily_summary
  recipients    String // JSON-encoded string[] of phone numbers
  body          String?
  relatedLeadId String?  @map("related_lead_id")
  sentAt        DateTime @default(now()) @map("sent_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relatedLead OutreachLead? @relation(fields: [relatedLeadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("outreach_notifications_log")
}

model OutreachRun {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  accountId    String?   @map("account_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  leadsFound   Int       @default(0) @map("leads_found")
  messagesSent Int       @default(0) @map("messages_sent")
  status       String    @default("running")
  notes        String?
  skippedLeads String?   @map("skipped_leads") // JSON -- per-lead skip reasons

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account OutreachAccount? @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([tenantId, startedAt])
  @@index([accountId, startedAt])
  @@map("outreach_runs")
}

model OutreachReply {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  leadId     String   @map("lead_id")
  accountId  String?  @map("account_id")
  channel    String
  body       String
  repliedAt  DateTime @map("replied_at")
  detectedAt DateTime @default(now()) @map("detected_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   OutreachLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([leadId, repliedAt])
  @@map("outreach_replies")
}
