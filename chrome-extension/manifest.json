{
  "manifest_version": 3,
  "name": "Nexaris Connect",
  "version": "1.0.0",
  "description": "Connect your LinkedIn or Instagram account to Nexaris without a remote browser window -- just log in normally, then click here.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["cookies"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.instagram.com/*",
    "https://app.nxrs.tech/*"
  ]
}
